# Kenya Farmer Hash Registry Environment Configuration Template
# Copy this file to .env and populate with cryptographically secure values

# Application Environment (development | production)
ENV=production

# Application Name
APP_NAME="Farmer Hash Registry"

# Server Rekeying Key (32-byte hex string generated via python scripts/generate_keys.py)
# REQUIRED in production. Never share with partners.
SERVER_KEY=CHANGE_ME

# Administrative API Key (for /admin/lookup)
# REQUIRED in production.
ADMIN_KEY=CHANGE_ME

# 2-of-3 Shamir Split-Key Evaluator Configuration
# Each independent evaluator party holds one share s_i (64-character hexadecimal scalar).
# EVALUATOR_SHARE_K is REQUIRED in ALL environments. Never commit to version control.
EVALUATOR_PARTY_ID=safic
EVALUATOR_PARTY_INDEX=1
EVALUATOR_SHARE_K=GENERATE_VIA_DEAL_SHARES_PY
EVALUATOR_KEY_ID=ke-pilot-v4
EVALUATOR_PEER_PUBKEYS=comma_separated_base64_k1_k2_k3
EVALUATOR_AGGREGATE_PUB=base64_aggregate_k

# PostgreSQL Database Password (for docker-compose)
POSTGRES_PASSWORD=CHANGE_ME

# Database URL (PostgreSQL for production; SQLite strictly for local development)
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/registry_db

# Pilot Start Date (YYYY-MM-DD) - rejects onboarded_at earlier than this date
PILOT_START_DATE=2026-10-01

# Privacy k-Anonymity Threshold (suppresses reporting cells with count < threshold)
SUPPRESSION_THRESHOLD=5

# Dashboard Basic Authentication Credentials
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CHANGE_ME

# Seed Test Partners on startup (Strictly allowed ONLY when ENV=development)
SEED_TEST_PARTNERS=false
